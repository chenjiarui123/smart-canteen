            "type": "string",
            "title": "School Break Type",
            "default": "非寒暑假"
          },
          "statutory_holiday": {
            "type": "boolean",
            "title": "Statutory Holiday"
          },
          "statutory_holiday_name": {
            "type": "string",
            "title": "Statutory Holiday Name",
            "default": "非节假日"
          },
          "adjusted_workday": {
            "type": "boolean",
            "title": "Adjusted Workday"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "school_break",
          "statutory_holiday",
          "adjusted_workday"
        ],
        "title": "Calendar"
      },
      "DataSnapshot": {
        "properties": {
          "snapshot_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Snapshot Id"
          },
          "canteen_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Canteen Id"
          },
          "canteen_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Canteen Name"
          },
          "unit_policy": {
            "type": "string",
            "enum": [
              "strict",
              "legacy_compatibility"

# ============================================================
#  智慧食堂启发式菜单推荐 — 仓库卫生规则
#  原则：保留可复现实验与交付件；大体积实验产物、原始台账不入库
# ============================================================

# ---------- macOS 垃圾 ----------
._*
.DS_Store
.AppleDouble
.Spotlight-V100
.Trashes

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.targeted-venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- Node ----------
node_modules/
.pnpm-store/
.vite/
*.log

# ---------- 大体积实验产物（约 18 GB，仅本地保留）----------
runs/
archive/
versions/

